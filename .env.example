# Copia este archivo como .env y completa los valores. El .env NO se sube al repositorio.

# Genera una clave propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True solo en desarrollo. En una presentación pública o un túnel (ngrok/cloudflared) usa False.
DEBUG=True

# Hosts permitidos separados por coma. Para usar el teléfono, agrega la IP del PC (ej. 192.168.1.10).
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes HTTPS de confianza para formularios, separados por coma (ej. https://192.168.1.10:8443).
CSRF_TRUSTED_ORIGINS=

# Base de datos. Vacío = SQLite local (db.sqlite3). Ejemplo PostgreSQL:
#   DATABASE_URL=postgres://usuario:clave@localhost:5432/botilleria
DATABASE_URL=

# Contraseñas de los usuarios de demo que crea "python manage.py seed_demo".
DEMO_ADMIN_PASSWORD=
DEMO_WORKER_PASSWORD=
